# Copiar a .env y ajustar. Todas las variables tienen valores por defecto seguros
# para desarrollo (SQLite). En producción usar PostgreSQL/PostGIS y un SECRET_KEY real.

APP_ENV=development
DEBUG=true

# Desarrollo (por defecto): SQLite
DATABASE_URL=sqlite:///./levantamiento.db
# Producción: PostgreSQL + PostGIS
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/levantamiento

# Seguridad — GENERAR uno nuevo en producción (p.ej. `openssl rand -hex 32`)
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Política de contraseñas (login local)
PASSWORD_MIN_LENGTH=10
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Autenticación corporativa (PD-05) — deshabilitada hasta definir infraestructura
CORPORATE_AUTH_ENABLED=false
LDAP_SERVER_URI=

# CORS (orígenes del frontend React)
# CORS_ORIGINS=["http://localhost:5173"]
